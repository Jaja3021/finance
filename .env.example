# Copy to .env.local and fill in.

# Required. Signs login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Enables the Gemini-powered chat parser and spending coach.
# Get a key at https://aistudio.google.com/apikey
# Without it, both fall back to built-in rules.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Optional. Fallback stock prices if Yahoo Finance is unavailable.
ALPHA_VANTAGE_KEY=

# Optional. Where the SQLite database lives (default ./data/finance.db).
# DATABASE_PATH=./data/finance.db

# Optional. Where daily backups go (default ./backups). Point this at a synced
# folder (OneDrive, Google Drive, Dropbox) for an off-device copy.
# BACKUP_DIR=
# BACKUP_KEEP=14

# Optional. Public URL when deployed, for fingerprint/face unlock (WebAuthn).
# WEBAUTHN_ORIGIN=https://money.example.com
